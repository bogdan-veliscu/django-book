# Django settings
DJANGO_SECRET_KEY=please_change_this_to_a_random_50_plus_character_string
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
POSTGRES_DB=conduit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Domain and SSL settings
DOMAIN=localhost
CERTBOT_EMAIL=your-email@example.com

# Next.js settings (for frontend)
NEXTAUTH_SECRET=please_change_this_to_a_random_32_plus_character_string
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Python settings
PYTHONPATH=/code/conduit
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Redis settings
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Security settings - disabled for local testing
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=True 