# Upstream definitions with keepalive - fixed format
upstream django_backend {
    server app:8000;
    keepalive 32;
}

upstream frontend_app {
    server frontend:3000;
    keepalive 32;
}

# HTTP redirect server
server {
    listen 80;
    listen [::]:80;
    server_name brandfocus.ai www.brandfocus.ai;
    return 301 https://${DOLLAR}host${DOLLAR}request_uri;
}

# HTTPS server
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name brandfocus.ai www.brandfocus.ai;

    # Disable trailing slash redirects globally
    absolute_redirect off;
    server_name_in_redirect off;
    port_in_redirect off;

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/brandfocus.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brandfocus.ai/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/brandfocus.ai/chain.pem;

    # SSL optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://brandfocus.ai wss://brandfocus.ai https://api.dicebear.com http://localhost:* http://127.0.0.1:* http://*.local:* https://brandfocus.ai/api https://brandfocus.ai/api/auth/*; font-src 'self' data:; img-src 'self' data: https://api.dicebear.com https://brandfocus.ai; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self';" always;

    # Handle Next.js static files with high priority - must come before the main location block
    location /_next/static/ {
        proxy_pass http://frontend_app/_next/static/;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        expires 365d;
    }

    # Handle Next.js public files
    location /public/ {
        proxy_pass http://frontend_app/public/;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
        expires 30d;
    }

    # Direct access to frontend without proxying through Nginx (for debugging)
    location /direct-frontend/ {
        proxy_pass http://frontend_app/;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_buffering off;
    }

    # Diagnostic endpoints to debug NextAuth
    location = /api/auth-debug {
        add_header Content-Type application/json;
        return 200 '{"status":"ok","timestamp":"${DOLLAR}time_iso8601","server":"nginx","headers":${DOLLAR}http_authorization}';
    }

    # Emergency authentication bypass
    location = /api/auth/emergency-session {
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin ${DOLLAR}http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        
        # Return a valid null session (non-authenticated but valid format)
        return 200 'null';
    }

    # Emergency authentication with mock user
    location = /api/auth/emergency-session-user {
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin ${DOLLAR}http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        
        # Return a mock session with user (authenticated session format)
        return 200 '{"user":{"name":"Emergency User","email":"emergency@example.com"},"expires":"2099-01-01T00:00:00.000Z"}';
    }

    # Emergency route to use the local fix server
    location = /api/auth/local-fix {
        proxy_pass http://frontend_app:3333/api/auth/session;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        proxy_buffering off;
        
        # Allow CORS
        add_header Access-Control-Allow-Origin ${DOLLAR}http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    }

    # Special handling for NextAuth session endpoint - strict JSON passthrough
    location = /api/auth/session {
        # Logging for debugging
        access_log /var/log/nginx/session_access.log;
        error_log /var/log/nginx/session_error.log debug;

        # Direct passthrough with minimal headers
        proxy_pass http://frontend_app/api/auth/session;
        proxy_http_version 1.1;
        
        # Critical - ensure JSON passes through untouched
        proxy_hide_header Content-Security-Policy;
        proxy_buffering off;
        proxy_set_header Accept "application/json";
        proxy_set_header Content-Type "application/json";
        
        # Only essential request headers
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        
        # Pass through content headers without modifying them
        proxy_pass_header Content-Type;
        proxy_pass_header Content-Length;
        
        # Essential CORS
        add_header Access-Control-Allow-Origin ${DOLLAR}http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        
        # Prevent any compression or transformation
        proxy_set_header Accept-Encoding "";
        
        # Extended timeout for debugging
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        
        # Fast OPTIONS response
        if (${DOLLAR}request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin ${DOLLAR}http_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept,Authorization,Content-Type,X-CSRF-Token,X-Requested-With" always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        
        # Fallback for errors
        proxy_intercept_errors on;
        error_page 400 401 402 403 404 405 500 501 502 503 504 =200 /api/auth-debug;
    }

    # Also add exact matches for other critical NextAuth endpoints
    location = /api/auth/signin {
        absolute_redirect off;
        port_in_redirect off;
        server_name_in_redirect off;
        proxy_redirect off;
        
        proxy_pass http://frontend_app/api/auth/signin;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
    }

    location = /api/auth/signout {
        absolute_redirect off;
        port_in_redirect off;
        server_name_in_redirect off;
        proxy_redirect off;
        
        proxy_pass http://frontend_app/api/auth/signout;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
    }

    # NextAuth.js API routes - must come before the general API proxy
    location ~ ^/api/auth/.+ {
        # Prevent redirect loops
        absolute_redirect off;
        port_in_redirect off;
        server_name_in_redirect off;
        proxy_redirect off;
        
        proxy_pass http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
        
        # CORS headers for NextAuth
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
        
        # Handle preflight OPTIONS requests
        if (${DOLLAR}request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain charset=UTF-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
    }

    # API proxy with proper CORS handling
    location /api/ {
        proxy_pass http://django_backend;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
        
        # Handle preflight OPTIONS requests
        if (${DOLLAR}request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain charset=UTF-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
        
        # Regular requests
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
    }

    # Static files
    location /static/ {
        alias /code/conduit/static/;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
        expires 30d;
    }

    # Media files
    location /media/ {
        alias /code/conduit/media/;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
        expires 30d;
    }

    # Health check endpoint
    location /health/ {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Frontend proxy - should be last to catch all other requests
    location / {
        proxy_pass http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
        
        # Avoid 502 errors during long-running operations
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        
        # Buffer settings for better performance
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }
} 