# Upstream definitions with keepalive for better performance
# Use resolver directive outside server blocks
resolver 127.0.0.11 ipv6=off;

upstream django_backend {
    server conduit-api:8000;
    keepalive 32;  # Keep connections alive for better performance
}

upstream nextjs_frontend {
    server conduit-frontend:3000;
    keepalive 32;  # Keep connections alive for better performance
}

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name ${VIRTUAL_HOST};
    return 301 https://${DOLLAR}server_name${DOLLAR}request_uri;
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    server_name ${VIRTUAL_HOST};

    # Add Docker DNS resolver
    resolver 127.0.0.11 ipv6=off valid=30s;  # Docker's internal DNS resolver
    
    # Set variables for backend services
    set $backend_host conduit-api;
    set $frontend_host conduit-frontend;

    # Critical: Disable all automatic redirects to prevent loops
    absolute_redirect off;
    server_name_in_redirect off;
    port_in_redirect off;

    # SSL configuration
    ssl_certificate /etc/nginx/ssl/live/${VIRTUAL_HOST}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${VIRTUAL_HOST}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${VIRTUAL_HOST}/chain.pem;

    # SSL optimization settings
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # OCSP Stapling for better SSL performance
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;

    # Security headers with NextAuth specific adjustments
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${VIRTUAL_HOST} ws://${VIRTUAL_HOST};" always;

    # Next.js static assets - must come before other location blocks
    location /_next/static/ {
        proxy_pass http://nextjs_frontend/_next/static/;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        expires 365d;
    }

    # Next.js public files
    location /public/ {
        proxy_pass http://nextjs_frontend/public/;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOLLAR}host;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
        expires 30d;
    }

    # NextAuth endpoints - handle both with and without trailing slash
    location ~ ^/api/auth/(.*?)/?$ {
        # Force correct MIME type for NextAuth responses
        add_header Content-Type application/json;
        
        # Disable redirects for session requests
        if ($args ~* "callback") {
            proxy_redirect off;
        }
        
        # Handle OAuth callback URLs
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Buffer settings to prevent 502 errors
        proxy_buffers 16 16k;
        proxy_buffer_size 16k;
        
        # Remove trailing slash if present and normalize path
        rewrite ^/api/auth/(.*?)/?$ /api/auth/$1 break;
        
        proxy_pass http://$frontend_host:3000;  # Use variable instead of upstream name
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${DOLLAR}host;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        
        # CORS headers for NextAuth
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
        
        # Handle preflight requests
        if (${DOLLAR}request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain charset=UTF-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
        
        # Increase timeouts for auth operations
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Django API endpoints - preserve /api prefix
    location /api/ {
        # Critical: Don't strip /api prefix when proxying to Django
        proxy_pass http://django_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${DOLLAR}host;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Prefix /api;  # Inform Django about the /api prefix
        
        # CORS headers for API
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
        
        # Handle preflight requests
        if (${DOLLAR}request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,X-CSRF-Token' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain charset=UTF-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
    }

    # Static files
    location /static/ {
        alias /app/static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Media files
    location /media/ {
        alias /app/media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Health check endpoint
    location /health/ {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Frontend application - catch all remaining requests
    location / {
        proxy_pass http://nextjs_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${DOLLAR}host;
        proxy_cache_bypass ${DOLLAR}http_upgrade;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
    }

    # Error pages
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
} 