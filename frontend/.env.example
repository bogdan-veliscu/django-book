# ============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update with your values
# This file contains environment variables for the Vite build process

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
# The frontend will make API requests to this URL
#
# Development (local backend):
# VITE_API_URL=http://localhost:8000
#
# Production (replace with your actual API domain):
# VITE_API_URL=https://api.conduit.example.com
#
# Staging:
# VITE_API_URL=https://staging-api.conduit.example.com

VITE_API_URL=http://localhost:8000

# ============================================
# NOTES
# ============================================
#
# 1. Vite Environment Variables:
#    - Only variables prefixed with VITE_ are exposed to the frontend
#    - They are embedded in the build at build time
#    - Changing these requires rebuilding the frontend
#
# 2. API URL Configuration:
#    - In development: Point to local backend (http://localhost:8000)
#    - In production: Point to production API domain
#    - Ensure CORS is configured on the backend to allow requests
#
# 3. Security:
#    - Never store secrets or sensitive data in frontend env vars
#    - These values are embedded in the client-side JavaScript
#    - Anyone can see them by inspecting the built files
#
# 4. Docker Build:
#    - Pass as build argument: docker build --build-arg VITE_API_URL=https://api.example.com
#    - Or set in docker-compose.yml under build.args
