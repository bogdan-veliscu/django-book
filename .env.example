# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control!

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=production
DEBUG=false

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection settings
POSTGRES_USER=conduit
POSTGRES_PASSWORD=your-secure-database-password-change-this
POSTGRES_DB=conduit_prod
POSTGRES_DEFAULT_PORT=5432

# Full database URL (auto-constructed in docker-compose)
# For external database, set this manually:
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database
DATABASE_ECHO=false

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis connection settings
REDIS_URL=redis://redis:6379/0

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# SECRET_KEY: Used for JWT token signing and cryptographic operations
# CRITICAL: Generate a secure random key for production!
#
# Generate a secure key using one of these methods:
# Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OpenSSL: openssl rand -base64 32
# Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# MUST be at least 32 characters long
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-AT-LEAST-32-CHARACTERS-LONG

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Production examples:
# CORS_ORIGINS=https://conduit.example.com,https://www.conduit.example.com
# Development:
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API URL for frontend to connect to backend
# In production, this should be your domain's API endpoint
# Examples:
# - Production: https://api.conduit.example.com
# - Staging: https://staging-api.conduit.example.com
# - Local: http://localhost:8000
VITE_API_URL=http://localhost:8000

# ============================================
# AWS S3 CONFIGURATION (Optional)
# ============================================
# Required for file uploads (user avatars, article images)
# Leave empty if not using S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# ============================================
# CACHE CONFIGURATION
# ============================================
# Cache TTL in seconds
CACHE_TTL_ARTICLES=300
CACHE_TTL_PROFILES=600
CACHE_TTL_TAGS=1800

# ============================================
# PAGINATION SETTINGS
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# LOGGING & MONITORING (Optional)
# ============================================
# LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ============================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================
#
# 1. Security Checklist:
#    ✓ Generate a strong SECRET_KEY
#    ✓ Use strong database password
#    ✓ Set ENVIRONMENT=production
#    ✓ Set DEBUG=false
#    ✓ Configure CORS_ORIGINS with your actual domain(s)
#    ✓ Never commit .env to version control
#
# 2. Database:
#    ✓ Use managed database service or ensure proper backups
#    ✓ Enable SSL/TLS for database connections in production
#    ✓ Set DATABASE_ECHO=false to reduce log noise
#
# 3. Redis:
#    ✓ Configure maxmemory and eviction policy
#    ✓ Enable persistence if needed (AOF/RDB)
#
# 4. Domain Configuration:
#    ✓ Update VITE_API_URL to your production API URL
#    ✓ Update CORS_ORIGINS to match your frontend domain(s)
#    ✓ Configure SSL/TLS certificates for HTTPS
#
# 5. Monitoring:
#    ✓ Configure error tracking (e.g., Sentry)
#    ✓ Set up application performance monitoring
#    ✓ Configure log aggregation
#
# 6. Scaling:
#    ✓ Use environment variables for all configuration
#    ✓ Store secrets in a secure vault (e.g., AWS Secrets Manager)
#    ✓ Consider using managed services for DB and Redis
